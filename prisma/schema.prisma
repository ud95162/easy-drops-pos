// Prisma schema for Easy Drops POS
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductType {
  LOOSE // sold by weight/measure; prices update when new stock arrives
  PACKET // sold as fixed packages at their set prices
}

model Product {
  id          String      @id @default(cuid())
  name        String // English / internal name
  sinhalaName String // Sinhala name printed on the receipt
  type        ProductType @default(PACKET)
  unit        String      @default("pcs") // e.g. kg, g, L, pcs
  category    String? // storefront category slug (see src/lib/categories.ts)

  costPrice    Decimal @default(0) @db.Decimal(12, 2)
  regularPrice Decimal @default(0) @db.Decimal(12, 2)
  salePrice    Decimal @default(0) @db.Decimal(12, 2)

  stock   Decimal @default(0) @db.Decimal(14, 3)
  barcode String? @unique
  active  Boolean @default(true)

  // Product photo shown on the storefront, stored in the DB.
  imageData Bytes? // raw image bytes
  imageType String? // MIME type, e.g. image/jpeg

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockEntries StockEntry[]
  saleItems    SaleItem[]
  batches      ProductBatch[]
  orderItems   OrderItem[]

  @@index([name])
  @@index([category])
}

// The public storefront/app catalog — managed separately from POS inventory.
// POS `Product` is the shop's internal stock; `EcomProduct` is what shoppers
// see online. They are intentionally decoupled: entries here are created and
// priced in the POS "Online Store" section, not from POS stock movements.
model EcomProduct {
  id          String      @id @default(cuid())
  name        String // English name
  sinhalaName String // Sinhala name (shown in Sinhala mode)
  type        ProductType @default(PACKET) // LOOSE = sold by weight (decimal qty)
  unit        String      @default("pcs") // e.g. kg, g, L, pcs
  category    String? // storefront category slug (see src/lib/categories.ts)
  subcategory String? // storefront subcategory slug within `category`

  regularPrice Decimal @default(0) @db.Decimal(12, 2)
  salePrice    Decimal @default(0) @db.Decimal(12, 2)

  inStock Boolean @default(true) // manual availability toggle
  active  Boolean @default(true) // published/visible on the storefront

  // Product photo shown online, stored in the DB.
  imageData Bytes? // raw image bytes
  imageType String? // MIME type, e.g. image/jpeg

  sortOrder Int      @default(0) // lower shows first
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([active])
}

// A storefront/app shopper account (separate from the credit-book Customer).
model AppUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  address      String?
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([email])
}

enum OrderStatus {
  PENDING // placed, awaiting payment
  PAID // payment received; ready to fulfil / becomes a sale
  CANCELLED
}

// An online order placed from the app. Stays PENDING until payment is
// confirmed — it is not a POS Sale until then.
model Order {
  id     String      @id @default(cuid())
  userId String
  user   AppUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status OrderStatus @default(PENDING)

  total Decimal @db.Decimal(12, 2)

  // Delivery details captured at checkout.
  name    String
  phone   String
  address String
  note    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Snapshot so the order stays correct even if the product changes later.
  productName String
  unit        String  @default("pcs")
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Decimal @db.Decimal(14, 3)
  lineTotal   Decimal @db.Decimal(12, 2)

  @@index([orderId])
}

// A priced stock batch for PACKET items. Each restock creates a batch;
// the POS sells the oldest batch first (FIFO) at that batch's price.
model ProductBatch {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  costPrice    Decimal @db.Decimal(12, 2)
  regularPrice Decimal @db.Decimal(12, 2)
  salePrice    Decimal @db.Decimal(12, 2)

  quantity  Decimal @db.Decimal(14, 3) // original quantity added
  remaining Decimal @db.Decimal(14, 3) // quantity still in stock

  createdAt DateTime @default(now())

  saleItems SaleItem[]

  @@index([productId])
  @@index([productId, remaining])
}

// A record every time stock is added. For LOOSE items the new prices
// captured here also become the product's current prices.
model StockEntry {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity     Decimal  @db.Decimal(14, 3)
  costPrice    Decimal  @db.Decimal(12, 2)
  regularPrice Decimal? @db.Decimal(12, 2)
  salePrice    Decimal? @db.Decimal(12, 2)
  note         String?

  createdAt DateTime @default(now())

  @@index([productId])
}

model Sale {
  id     String  @id @default(cuid())
  total  Decimal @db.Decimal(12, 2)
  paid   Decimal @default(0) @db.Decimal(12, 2)
  change Decimal @default(0) @db.Decimal(12, 2)
  credit Decimal @default(0) @db.Decimal(12, 2) // unpaid portion added to a customer's balance

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdAt DateTime   @default(now())
  items     SaleItem[]

  @@index([createdAt])
  @@index([customerId])
}

// A credit customer whose unpaid balances are tracked ("credit book").
model Customer {
  id      String  @id @default(cuid())
  name    String
  phone   String?
  note    String?
  // Amount the customer currently owes the shop (credit taken minus repayments).
  balance Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales    Sale[]
  payments CustomerPayment[]

  @@index([name])
}

// A repayment a customer makes against their balance.
model CustomerPayment {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(12, 2)
  note       String?
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model SaleItem {
  id     String @id @default(cuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // For PACKET items, which priced batch this line was sold from (for FIFO
  // stock restore when a sale is voided).
  batchId String?
  batch   ProductBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  // Snapshots so receipts/history stay correct even if the product changes later
  productName        String
  productSinhalaName String
  unit               String  @default("pcs")

  quantity     Decimal @db.Decimal(14, 3)
  costPrice    Decimal @default(0) @db.Decimal(12, 2) // cost at time of sale
  regularPrice Decimal @default(0) @db.Decimal(12, 2) // normal price (shown on receipt)
  unitPrice    Decimal @db.Decimal(12, 2) // sale price / "Ape Milla" actually charged
  lineTotal    Decimal @db.Decimal(12, 2)

  @@index([saleId])
}
