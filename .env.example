# --- Database (Postgres) ---
# Get a free Postgres database from Neon (https://neon.tech) or Vercel Postgres.
# Use the POOLED connection string here (recommended for serverless / Vercel).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth ---
# The shared cashier password used to log in to the POS.
POS_PASSWORD="changeme"
# A long random string used to sign the login session cookie.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="please-change-this-to-a-long-random-string"
